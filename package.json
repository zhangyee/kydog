{
  "name": "kydog",
  "productName": "KyDog",
  "version": "0.3.1",
  "description": "KyDog — an AI research agent for academic literature discovery, review, and frontier insight.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/install-cli.mjs",
    "cli:update": "node scripts/update-cli.mjs",
    "onboarding:reset": "node scripts/reset-onboarding.mjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "keywords": [
    "electron",
    "ai-agent",
    "deepresearch",
    "academic",
    "papers"
  ],
  "author": {
    "name": "Yee Zhang",
    "email": "yee.zhang@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangyee/kydog.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.7.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tar": "^6.1.13",
    "@types/word-extractor": "^1.0.6",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "41.2.1",
    "eslint": "^9.12.0",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@milkdown/crepe": "^7.21.1",
    "chokidar": "^5.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "katex": "^0.16.46",
    "mammoth": "^1.12.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-pdf": "^9.2.1",
    "remark-gfm": "^4.0.0",
    "tar": "^7.4.3",
    "typebox": "1.1.38",
    "word-extractor": "^1.0.4",
    "zod": "^4.4.1",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "@electron-forge/plugin-fuses": {
      "@electron/fuses": "$@electron/fuses"
    }
  }
}
